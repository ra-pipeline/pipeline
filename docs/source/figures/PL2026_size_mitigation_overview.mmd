%%{init: {"flowchart": {"defaultRenderer": "elk"}} }%%
flowchart LR
    classDef default fill:#fff,stroke:#333,stroke-width:1px,color:#000;
    classDef pill fill:#ffebcc,stroke:#d4a373,stroke-width:1px,color:#000;
    classDef jump fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#000,stroke-dasharray: 5 5;

    subgraph Step4["Step 4: Long-run Warning"]
        FromS3("⤴ From Step 3"):::jump --> S4["4: Long-run warning assessment"]
        S4 --> EndNode([End]):::pill
    end

    subgraph Step3["Step 3: Spectral Window Filtering"]
        FromS2("⤴ From Step 2"):::jump --> S3a["3a: Cube size check"]
        S3a --> S3b["3b: Product size iteration"]
        S3b --> GotoS4("Next: Step 4 ⤵"):::jump
    end    

    subgraph Step2["Step 2: Total Product Size Mitigation"]
        FromS1("⤴ From Step 1"):::jump --> S2a["2a: Target reduction & Nbin"]
        S2a --> S2b["2b: PB & Cell size reduction"]
        S2b --> GotoS3("Next: Step 3 ⤵"):::jump
    end

    subgraph Step1["Step 1: Cube Size Mitigation"]
        Start([Begin]):::pill --> S1a["1a: Channel binning (nbin)"]
        S1a --> S1b["1b: FOV / PB reduction"]
        S1b --> S1c["1c: Cell size reduction"]
        S1c --> GotoS2("Next: Step 2 ⤵"):::jump
    end

    style Step1 fill:#f0f8ff,stroke:#0288d1,stroke-width:1.5px;
    style Step2 fill:#f1f8e9,stroke:#388e3c,stroke-width:1.5px;
    style Step3 fill:#fdf2e9,stroke:#e65100,stroke-width:1.5px;
    style Step4 fill:#f5f5f5,stroke:#616161,stroke-width:1.5px;
